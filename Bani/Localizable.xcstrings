    "Trailing accuracy over each rule's last 20 decisions. A rule becomes Trusted at ≥95% with ≥10 decisions and auto-saves; it drops back to Asking below 90%.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trailing accuracy over each rule's last 20 decisions. A rule becomes Trusted at ≥95% with ≥10 decisions and auto-saves; it drops back to Asking below 90%."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acuratețea recentă pe ultimele 20 de decizii ale fiecărei reguli. O regulă devine De încredere la ≥95% cu ≥10 decizii și salvează automat; revine la Întreabă sub 90%."
          }
        }
      }
    },
