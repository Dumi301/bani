      }
    },
    "backup.footer": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Export a full backup of everything in Bani, or restore from a previous one. Backups never leave your device unless you share them yourself." } },
        "ro": { "stringUnit": { "state": "translated", "value": "Exportă un backup complet cu tot ce ai în Bani sau restaurează dintr-unul anterior. Backup-urile nu părăsesc telefonul decât dacă le trimiți tu însuți." } }
      }
    },
    "backup.export.button": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Export backup" } },
        "ro": { "stringUnit": { "state": "translated", "value": "Exportă backup" } }
