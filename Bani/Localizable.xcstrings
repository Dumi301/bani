      }
    },
    "backup.restore.erase.confirm.title": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This device already has data" } },
        "ro": { "stringUnit": { "state": "translated", "value": "Acest telefon are deja date" } }
