    },
    "backup.restore.erase.confirm.message %lld": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Restoring will permanently erase %lld existing rows and replace them with the backup. This can't be undone." } },
        "ro": { "stringUnit": { "state": "translated", "value": "Restaurarea va șterge definitiv %lld rânduri existente și le va înlocui cu cele din backup. Această acțiune nu poate fi anulată." } }
