    "A keyword pre-selects its context once it has ≥3 confirmations and ≥80% of that keyword's saves.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A keyword pre-selects its context once it has ≥3 confirmations and ≥80% of that keyword's saves."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cuvânt-cheie preselectează contextul odată ce are ≥3 confirmări și ≥80% din salvările acelui cuvânt."
          }
        }
      }
    },
