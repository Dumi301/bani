# Force LF in the repo and working tree so shell/YAML/Python/Swift never carry
# CRLF onto the macOS CI runner (a stray \r breaks bash and YAML parsing).
* text=auto eol=lf

# Binary assets must never get EOL/text normalization.
*.png binary
*.wav binary
*.ipa binary
# .xlsx is a zipped OOXML archive — EOL normalization would corrupt the zip
# (the bundled import test fixture must survive the round-trip byte-for-byte).
*.xlsx binary
